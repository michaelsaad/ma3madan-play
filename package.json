{
  "name": "ma3madan-video-presenter",
  "version": "1.3.3",
  "description": "Video player for churches and events: controls on your screen, clean full-screen video on the projector. Plays local files and YouTube.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis",
    "icon": "electron build/make-icon.js",
    "test:media": "node test/make-media.js",
    "test": "node test/run-selftest.js"
  },
  "keywords": [
    "electron",
    "video-player",
    "presenter",
    "projector",
    "church",
    "youtube",
    "yt-dlp"
  ],
  "author": {
    "name": "Ma3madan Video Presenter"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0"
  },
  "productName": "Ma3madan Video Presenter",
  "build": {
    "appId": "com.michaelsaad.ma3madan",
    "productName": "Ma3madan Video Presenter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Ma3madan-Video-Presenter-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ma3madan Video Presenter",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "Ma3madan-Video-Presenter-Portable-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v",
          "mkv",
          "webm",
          "mov"
        ],
        "name": "Ma3madan.Video",
        "description": "Video",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp3",
          "m4a",
          "wav",
          "aac",
          "ogg",
          "opus",
          "flac"
        ],
        "name": "Ma3madan.Audio",
        "description": "Audio",
        "role": "Viewer"
      }
    ],
    "copyright": "Public domain",
    "electronLanguages": [
      "en-US",
      "ar"
    ],
    "compression": "maximum",
    "asarUnpack": [
      "src/vocals/worker.js"
    ]
  },
  "homepage": "https://github.com/michaelsaad/ma3madan-video-presenter",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelsaad/ma3madan-video-presenter.git"
  }
}
